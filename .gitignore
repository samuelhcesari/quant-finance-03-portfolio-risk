# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Données : les états financiers (SEC, domaine public) et les facteurs Fama-French
# sont committés ; les prix Yahoo (make fetch) ne sont pas redistribuables.
data/*
!data/financials_annual.csv
!data/ff_factors_daily.csv
!data/README.md

# Résultats : les figures et les JSON de chiffres sont committés volontairement,
# pour être lisibles sur GitHub sans exécuter le pipeline.
results/*
!results/figures/
!results/benchmark_*.json

.env
.DS_Store
